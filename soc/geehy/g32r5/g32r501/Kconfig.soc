config SOC_SERIES_G32R501
	bool "G32R501 Series MCU"
	select ARM
	select SOC_FAMILY_G32R5
	select CPU_HAS_FPU
	select CPU_CORTEX_M52
	select ARMV8_1_M_MVEI
	select ARMV8_1_M_MVEF

	select SOC_PREP_HOOK

	help
	  Enable support for Geehy G32R501 MCU series

config SOC_SERIES
	default "g32r501" if SOC_SERIES_G32R501

config SOC_G32R501DVXT
	bool "G32R501DVXT"
	select SOC_SERIES_G32R501

config SOC_G32R501DRXT
	bool "G32R501DRXT"
	select SOC_SERIES_G32R501

config SOC_G32R501DMXT
	bool "G32R501DMXT"
	select SOC_SERIES_G32R501

# G32R501DPYT7: 80-pin LQFP 10mm x 10mm. Same pinout as DMYT7
# (80-pin LQFP 12mm x 12mm); only the package body size differs.
config SOC_G32R501DPXT
	bool "G32R501DPXT"
	select SOC_SERIES_G32R501

config SOC_G32R501DNXU
	bool "G32R501DNXU"
	select SOC_SERIES_G32R501

config SOC_G32R501VXT
	bool "G32R501VXT"
	select SOC_SERIES_G32R501

config SOC_G32R501RXT
	bool "G32R501RXT"
	select SOC_SERIES_G32R501

config SOC_G32R501MXT
	bool "G32R501MXT"
	select SOC_SERIES_G32R501

config SOC_G32R501NXU
	bool "G32R501NXU"
	select SOC_SERIES_G32R501

config SOC
	default "g32r501dvxt" if SOC_G32R501DVXT
	default "g32r501drxt" if SOC_G32R501DRXT
	default "g32r501dmxt" if SOC_G32R501DMXT
	default "g32r501dpxt" if SOC_G32R501DPXT
	default "g32r501dnxu" if SOC_G32R501DNXU
	default "g32r501vxt" if SOC_G32R501VXT
	default "g32r501rxt" if SOC_G32R501RXT
	default "g32r501mxt" if SOC_G32R501MXT
	default "g32r501nxu" if SOC_G32R501NXU

config NUM_IRQS
	default 227
