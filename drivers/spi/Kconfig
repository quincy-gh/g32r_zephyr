config SPI
	default y if DT_HAS_GEEHY_G32R5_SPI_ENABLED

config SPI_G32R5
	bool "G32R5 SPI driver"
	default y
	depends on SPI
	depends on DT_HAS_GEEHY_G32R5_SPI_ENABLED
	help
	  Enable the Zephyr SPI driver for the G32R5 SPI controllers.
	  G32R501 has SPIA and SPIB. G32R502 has SPIA only.
